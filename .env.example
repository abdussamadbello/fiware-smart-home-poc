# FIWARE Smart Home PoC — thesis-faithful reimplementation 2026
# Copy to .env and adjust. Do not commit real secrets.

# --- Ports ---
ORION_PORT=1026
IOTA_NORTH_PORT=4041
IOTA_SOUTH_PORT=7896
QUANTUMLEAP_PORT=8668
KEYROCK_PORT=3005
MYSQL_PORT=3306
MONGO_DB_PORT=27017
CRATE_HTTP_PORT=4200
REDIS_PORT=6379
WEBAPP_PORT=8080

# --- Image versions (pinned for reproducibility) ---
ORION_VERSION=3.11.0
IOTA_JSON_VERSION=2.4.0
KEYROCK_VERSION=8.4.0
QUANTUMLEAP_VERSION=1.0.0
MONGO_DB_VERSION=6.0
MYSQL_VERSION=5.7
CRATE_VERSION=5.6.1
REDIS_VERSION=7.2

# --- Mongo / MySQL ---
MYSQL_ROOT_PASSWORD=secret
IDM_DB_PASS=secret

# --- Keyrock admin (demo only) ---
IDM_ADMIN_USER=admin
IDM_ADMIN_EMAIL=admin@test.com
IDM_ADMIN_PASS=1234
IDM_HOST=http://localhost:3005

# --- OAuth2 application for web app (provision script fills/uses these) ---
OAUTH2_CLIENT_ID=smart-home-app
OAUTH2_CLIENT_SECRET=smart-home-secret-change-me
OAUTH2_CALLBACK_URL=http://localhost:8080/auth/callback

# --- Demo users (created by provision; also used by app local-fallback) ---
DEMO_ADMIN_EMAIL=homeowner@smarthome.local
DEMO_ADMIN_PASSWORD=HomeOwner2022!
DEMO_GUEST_EMAIL=guest@smarthome.local
DEMO_GUEST_PASSWORD=GuestView2022!

# --- Fiware-Service ---
FIWARE_SERVICE=smartHome
FIWARE_SERVICEPATH=/

# --- CrateDB heap (lower if RAM-limited; default tutorials use 2g) ---
CRATE_HEAP_SIZE=512m

# --- Web app ---
WEBAPP_SECRET_KEY=change-me-session-secret
ORION_URL=http://orion:1026
IOTA_URL=http://iot-agent:4041
QUANTUMLEAP_URL=http://quantumleap:8668
KEYROCK_URL=http://keyrock:3005
# host-reachable URLs for browser/OAuth redirects
KEYROCK_PUBLIC_URL=http://localhost:3005
ORION_PUBLIC_URL=http://localhost:1026
AUTH_MODE=keyrock
# AUTH_MODE=local  # fallback if Keyrock unavailable
